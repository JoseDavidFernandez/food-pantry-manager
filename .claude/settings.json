{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(composer setup *)",
      "Bash(composer run setup *)",
      "Bash(composer run-script setup *)",
      "Bash(php artisan migrate:fresh *)",
      "Bash(php artisan migrate:reset *)",
      "Bash(php artisan migrate:refresh *)",
      "Bash(php artisan db:wipe *)",
      "Bash(laravel new *--force*)",
      "Bash(laravel new * -f*)",
      "Bash(laravel new -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ],
    "ask": [
      "Bash(php artisan migrate*)",
      "Bash(php artisan db:seed*)",
      "Bash(composer require *)",
      "Bash(composer update *)",
      "Bash(composer install *)",
      "Bash(composer remove *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx shadcn-vue* add *)",
      "Bash(git push *)",
      "Edit(/CLAUDE.md)",
      "Edit(/PRD.md)",
      "Edit(/TECHNICAL-DESIGN.md)",
      "Edit(/DATA-MODEL.md)",
      "Edit(/USER-FLOWS.md)",
      "Edit(/DESIGN-SYSTEM.md)",
      "Edit(/ROADMAP.md)"
    ],
    "allow": [
      "Bash(composer ci:check)",
      "Bash(composer test)",
      "Bash(composer lint:check)",
      "Bash(composer types:check)",
      "Bash(npm run check)",
      "Bash(npm run types:check)",
      "Bash(npm run build)",
      "Bash(npm audit)",
      "Bash(php artisan test)",
      "Bash(php artisan test *)"
    ]
  }
}
